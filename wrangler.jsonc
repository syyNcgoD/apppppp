{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apppppp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a37b7e90-f7d8-4029-a30d-e20f1078bf60","database_name": "ap0ppp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7c7309b8758f4ac2af3447a61e12c2d8" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
